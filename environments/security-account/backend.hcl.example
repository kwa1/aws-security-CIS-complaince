# Copy to prod.backend.hcl (committed; contains no secrets) and run:
#   terraform init -backend-config=prod.backend.hcl
# One state key per account+region.
bucket       = "org-sec-tfstate-111111111111"
key          = "security-account/us-east-1/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:111111111111:key/REPLACE-WITH-bootstrap-output-state_kms_key_arn"
use_lockfile = true
