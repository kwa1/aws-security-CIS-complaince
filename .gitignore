# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Lock files: commit them for deployable roots (bootstrap/, environments/*).
# Modules are not deployed on their own, so their local lock files are ignored.
modules/**/.terraform.lock.hcl

# Lambda build output (generated by archive_file)
build/
__pycache__/
*.pyc
.pytest_cache/

# Secrets / local environment - never commit
.env
.env.*
*.pem
*.key
*.p12
secrets.*
*.secret.tfvars
*.auto.tfvars
.aws/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local tooling
.bob/
.tflint.d/
